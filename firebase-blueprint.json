{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores student merit data and core profile information.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "grades": { "type": "string" },
        "englishProficiency": { "type": "string" },
        "leadership": { "type": "string" },
        "aspirations": { "type": "string" },
        "targetRegion": { "type": "string" },
        "meritId": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "meritId"]
    },
    "Application": {
      "title": "Scholarship Application",
      "description": "Represents a student's application to a specific institution or award.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "university": { "type": "string" },
        "program": { "type": "string" },
        "status": { "type": "string", "enum": ["Draft", "Pending", "Accepted", "Rejected"] },
        "deadline": { "type": "string" },
        "progress": { "type": "number", "minimum": 0, "maximum": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "university", "program", "status"]
    },
    "Document": {
      "title": "Merit Document",
      "description": "Supporting documents for scholarship applications.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["Uploading", "Verified", "Error"] },
        "size": { "type": "string" },
        "fileUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "type", "status"]
    },
    "ChatMessage": {
       "title": "Chat Message",
       "description": "Messages exchanged between student and AI Counselor.",
       "type": "object",
       "properties": {
         "userId": { "type": "string" },
         "role": { "type": "string", "enum": ["user", "ai"] },
         "text": { "type": "string" },
         "timestamp": { "type": "string", "format": "date-time" }
       },
       "required": ["userId", "role", "text", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Root user profile document."
    },
    "applications/{applicationId}": {
      "schema": "Application",
      "description": "Global collection of scholarship applications."
    },
    "documents/{documentId}": {
      "schema": "Document",
      "description": "Global collection of student documents."
    },
    "chats/{chatId}": {
      "schema": "ChatMessage",
      "description": "Historical log of counseling sessions."
    }
  }
}
